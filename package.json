{
  "name": "kipu-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf .test-out && npx tsc src/lib/profiles.ts src/lib/profiles.test.ts src/lib/library.ts src/lib/library.test.ts --outDir .test-out --module commonjs --target es2022 --skipLibCheck --esModuleInterop && node --test .test-out/profiles.test.js .test-out/library.test.js; s=$?; rm -rf .test-out; exit $s",
    "predev": "node scripts/gen-fcm-sw.mjs",
    "prebuild": "node scripts/gen-fcm-sw.mjs"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
